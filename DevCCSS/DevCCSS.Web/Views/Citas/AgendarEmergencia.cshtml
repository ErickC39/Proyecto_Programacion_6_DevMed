@model DevCCSS.Web.Contracts.AgendarEmergenciaDto

@{
    ViewData["Title"] = "Cita de emergencia";
}

<h2 class="text-danger"><i class="bi bi-exclamation-octagon"></i> Agendar cita de emergencia</h2>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<form asp-action="AgendarEmergencia" method="post">
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Empleado (paciente de emergencia)</label>
            <select asp-for="IdEmpleado" class="form-select">
                <option value="">-- Seleccione --</option>
                @foreach (var e in (List<DevCCSS.Web.Contracts.EmpleadoDto>)ViewBag.EmpleadosVinculados)
                {
                    <option value="@e.IdEmpleado">@e.Nombre @e.Apellidos</option>
                }
            </select>
            <span asp-validation-for="IdEmpleado" class="text-danger"></span>
            @if (!((List<DevCCSS.Web.Contracts.EmpleadoDto>)ViewBag.EmpleadosVinculados).Any())
            {
                <small class="text-danger">No hay empleados vinculados a un paciente todavía. Vincule uno desde Empleados.</small>
            }
        </div>
        <div class="col-md-4">
            <label class="form-label">Especialidad requerida</label>
            <select id="filtroEspecialidad" class="form-select">
                <option value="">-- Todas --</option>
                @foreach (var esp in (List<DevCCSS.Web.Contracts.EspecialidadDto>)ViewBag.Especialidades)
                {
                    <option value="@esp.IdEspecialidad">@esp.Nombre</option>
                }
            </select>
        </div>

        <div class="col-md-4">
            <label class="form-label">Médico</label>
            <select asp-for="IdMedico" id="selectMedico" class="form-select">
                <option value="">-- Seleccione --</option>
                @foreach (var m in (List<DevCCSS.Web.Contracts.MedicoDto>)ViewBag.Medicos)
                {
                    <option value="@m.IdEmpleado" data-especialidad="@m.IdEspecialidad">@m.Nombre @m.Apellidos — @m.Especialidad</option>
                }
            </select>
            <span asp-validation-for="IdMedico" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label class="form-label">Fecha y hora</label>
            <input asp-for="FechaHoraCita" class="form-control" value="@DateTime.Now.AddMinutes(15).ToString("yyyy-MM-ddTHH:mm")" />
            <span asp-validation-for="FechaHoraCita" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-4">
        <button class="btn btn-danger" type="submit">
            <i class="bi bi-lightning-charge"></i> Agendar de emergencia
        </button>
        <a class="btn btn-secondary" asp-action="Index">Volver</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var filtro = document.getElementById('filtroEspecialidad');
            var select = document.getElementById('selectMedico');
            if (!filtro || !select) return;
            var opciones = Array.from(select.options);
            filtro.addEventListener('change', function () {
                var idEsp = filtro.value;
                opciones.forEach(function (opt) {
                    if (!opt.value) { opt.hidden = false; return; }
                    opt.hidden = idEsp !== '' && opt.dataset.especialidad !== idEsp;
                });
                if (select.selectedOptions[0] && select.selectedOptions[0].hidden) {
                    select.value = '';
                }
            });
        })();
    </script>
}
