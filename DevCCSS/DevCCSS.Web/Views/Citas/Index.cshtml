@model List<DevCCSS.Web.Contracts.CitaDto>
@{
    ViewData["Title"] = "Citas";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-calendar2-check"></i> Citas</h2>
    <a class="btn btn-primary" asp-action="Agendar"><i class="bi bi-plus-lg"></i> Agendar cita</a>
</div>

<!-- Buscador dinamico -->
<div class="row g-2 mb-3">
    <div class="col-md-6">
        <input type="text" id="buscador" class="form-control"
               placeholder="Buscar por paciente, medico o identificacion..." />
    </div>
    <div class="col-md-3">
        <select id="filtroEstado" class="form-select" data-campo="estado">
            <option value="">Todos los estados</option>
            @foreach (var estado in Model.Select(c => c.EstadoCita).Distinct().OrderBy(x => x))
            {
                <option value="@estado">@estado</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select id="filtroPrioridad" class="form-select" data-campo="prioridad">
            <option value="">Toda prioridad</option>
            <option value="Alta">Urgencia</option>
            <option value="Normal">Normal</option>
        </select>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Paciente</th>
                <th>Medico</th>
                <th>Fecha y hora</th>
                <th>Espera (min)</th>
                <th>Estado</th>
                <th>Prioridad</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr class="fila-cita"
                    data-buscar="@($"{c.PacienteNombreCompleto} {c.PacienteIdentificacion} {c.MedicoNombreCompleto}".ToLower())"
                    data-estado="@c.EstadoCita"
                    data-prioridad="@(c.PrioridadCita ?? "Normal")">
                    <td>@c.PacienteNombreCompleto <small class="text-muted">(@c.PacienteIdentificacion)</small></td>
                    <td>@c.MedicoNombreCompleto <small class="text-muted">@c.Especialidad</small></td>
                    <td>
                        @c.FechaHoraCita.ToString("dd/MM/yyyy HH:mm")
                        @if (c.FueReagendadaPorEmergencia)
                        {
                            <i class="bi bi-exclamation-octagon-fill text-warning" title="Trasladada por una emergencia"></i>
                        }
                    </td>
                    <td>
                        @c.TiempoEsperaMinutos
                        @if (c.TiempoEsperaMinutos > 60)
                        {
                            <i class="bi bi-exclamation-triangle-fill text-danger" title="Excede el maximo permitido (1 hora)"></i>
                        }
                    </td>
                    <td>
                        @{
                            var badge = c.EstadoCita switch
                            {
                                "Agendada" => "bg-secondary",
                                "En espera" => "bg-warning text-dark",
                                "En Progreso" => "bg-info text-dark",
                                "Finalizada" => "bg-success",
                                "Cancelada" => "bg-dark",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badge">@c.EstadoCita</span>
                    </td>
                    <td>
                        @if (c.PrioridadCita == "Alta")
                        {
                            <span class="badge bg-danger">Urgencia</span>
                        }
                        else
                        {
                            <span class="badge bg-light text-dark">Normal</span>
                        }
                    </td>
                    <td class="text-end">
                        <div class="btn-group" role="group">
                            <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@c.IdCita" title="Ver detalle"><i class="bi bi-eye"></i></a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@c.IdCita" title="Eliminar"><i class="bi bi-trash"></i></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div id="sinResultados" class="text-center text-muted py-4" style="display:none;">
    No se encontraron citas con esa busqueda.
</div>

<nav>
    <ul class="pagination justify-content-center" id="paginacion"></ul>
</nav>

@section Scripts {
    <script>
        initTablaFiltro({
            filas: '.fila-cita',
            buscador: '#buscador',
            filtros: ['#filtroEstado', '#filtroPrioridad'],
            contenedorPaginacion: '#paginacion',
            sinResultados: '#sinResultados'
        });
    </script>
}
