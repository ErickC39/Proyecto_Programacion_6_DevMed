@model DevCCSS.Web.Contracts.CitaDto

@{
    ViewData["Title"] = "Detalle de la cita";
}

<h2 class="mb-3">
    <i class="bi bi-calendar-check"></i> Detalle de la cita
</h2>

@if (ViewBag.AvisoDemora != null)
{
    <div class="alert alert-warning"><i class="bi bi-clock-history"></i> @ViewBag.AvisoDemora</div>
}

@if (Model.FueReagendadaPorEmergencia)
{
    <div class="alert alert-info">
        <i class="bi bi-exclamation-octagon"></i>
        @(Model.MensajeReagendo ?? "Su cita fue trasladada porque ocurrió una emergencia y el médico debió atenderla primero.")
    </div>
}

<div class="card shadow-sm">
    <div class="card-body">

        <dl class="row mb-0">

            <dt class="col-sm-3">Médico</dt>
            <dd class="col-sm-9">@Model.MedicoNombreCompleto</dd>

            <dt class="col-sm-3">Especialidad</dt>
            <dd class="col-sm-9">@Model.Especialidad</dd>

            <dt class="col-sm-3">Fecha y hora</dt>
            <dd class="col-sm-9">@Model.FechaHoraCita.ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3">Llegada</dt>
            <dd class="col-sm-9">
                @(Model.FechaHoraLlegada.HasValue ? Model.FechaHoraLlegada.Value.ToString("dd/MM/yyyy HH:mm") : "Pendiente")
            </dd>

            <dt class="col-sm-3">Tiempo de espera</dt>
            <dd class="col-sm-9">
                @Model.TiempoEsperaMinutos minutos
                @if (Model.TiempoEsperaMinutos > 60)
                {
                    <span class="badge bg-danger ms-2">
                        <i class="bi bi-exclamation-triangle"></i> Excede el máximo permitido (1 hora)
                    </span>
                }
            </dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                <span class="badge bg-secondary">@Model.EstadoCita</span>
            </dd>

            <dt class="col-sm-3">Espacio requerido</dt>
            <dd class="col-sm-9">
                @(Model.TipoHabitacionRequerido ?? "-")
                @if (Model.NumeroHabitacionAsignada != null)
                {
                    <span class="badge bg-info text-dark ms-1">
                        <i class="bi bi-door-open"></i> Asignado: @Model.NumeroHabitacionAsignada
                    </span>
                }
                else if (Model.EstadoCita == "En Progreso" || Model.EstadoCita == "Finalizada")
                {
                    <span class="text-muted small ms-1">(sin espacio disponible al momento de atender)</span>
                }
            </dd>

            <dt class="col-sm-3">Prioridad</dt>
            <dd class="col-sm-9">
                @if (Model.PrioridadCita == "Alta")
                {
                    <span class="badge bg-danger">Urgencia</span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary-emphasis">Normal</span>
                }
            </dd>

            @if (Model.EstadoCita == "Finalizada")
            {
                <dt class="col-sm-3">Resultado</dt>
                <dd class="col-sm-9">@Model.ResultadoConsulta</dd>

                <dt class="col-sm-3">Control</dt>
                <dd class="col-sm-9">@(Model.RequiereControl ? "Sí" : "No")</dd>
            }

        </dl>

    </div>
</div>

<div class="mt-3">

    @if (!Model.FechaHoraLlegada.HasValue)
    {
        <form asp-action="RegistrarLlegada" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.IdCita" />
            <button type="submit" class="btn btn-outline-primary">
                <i class="bi bi-door-open"></i> Registrar llegada
            </button>
        </form>
    }

    @if (Model.EstadoCita == "En espera")
    {
        <button type="button" class="btn btn-outline-info" data-bs-toggle="modal" data-bs-target="#modalIniciarAtencion">
            <i class="bi bi-person-check"></i> Iniciar atención
        </button>
    }

    @if (Model.EstadoCita == "En Progreso")
    {
        <a asp-action="Finalizar"
           asp-route-id="@Model.IdCita"
           class="btn btn-success">
            <i class="bi bi-check2-circle"></i> Finalizar cita
        </a>
    }

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>

    @if (Model.EstadoCita != "Finalizada" &&
     Model.EstadoCita != "Cancelada")
    {
        <form asp-action="Cancelar"
              method="post"
              class="d-inline"
              onsubmit="return confirm('¿Cancelar esta cita?');">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.IdCita" />

            <button class="btn btn-outline-danger"
                    type="submit">
                <i class="bi bi-x-circle"></i>
                Cancelar cita
            </button>

        </form>
    }

</div>

@if (Model.EstadoCita == "En espera")
{
    var habitacionesDisponibles = (List<DevCCSS.Web.Contracts.HabitacionDto>)(ViewBag.HabitacionesDisponibles ?? new List<DevCCSS.Web.Contracts.HabitacionDto>());

    <div class="modal fade" id="modalIniciarAtencion" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="IniciarAtencion" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.IdCita" />
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-person-check"></i> Iniciar atención</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        @if (Model.IdTipoHabitacionRequerido.HasValue)
                        {
                            <label class="form-label">Habitación donde será atendido (@Model.TipoHabitacionRequerido)</label>
                            @if (habitacionesDisponibles.Any())
                            {
                                <select name="idHabitacion" class="form-select">
                                    <option value="">-- Sin asignar --</option>
                                    @foreach (var h in habitacionesDisponibles)
                                    {
                                        <option value="@h.IdHabitacion">@h.NumeroHabitacion</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <p class="text-muted mb-0">No hay habitaciones disponibles del tipo requerido en este momento. La atención se puede iniciar igual, sin espacio asignado.</p>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0">Esta cita no requiere un espacio físico.</p>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-info"><i class="bi bi-play-fill"></i> Confirmar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}