@model List<DevCCSS.Web.Contracts.HabitacionDto>
@{
    ViewData["Title"] = "Habitaciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-door-open"></i> Habitaciones</h2>
    @if (User.IsInRole("Administrador") || User.IsInRole("Enfermeria"))
    {
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-plus-lg"></i> Registrar habitación
        </a>
    }
</div>

<div class="row g-2 mb-3">
    <div class="col-md-8">
        <input type="text" id="buscador" class="form-control"
               placeholder="Buscar por número, tipo o paciente..." />
    </div>
    <div class="col-md-4">
        <select id="filtroEstado" class="form-select" data-campo="estado">
            <option value="">Todos los estados</option>
            @foreach (var estado in Model.Select(x => x.EstadoHabitacion).Distinct().OrderBy(x => x))
            {
                <option value="@estado">@estado</option>
            }
        </select>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Número</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th>Paciente asignado</th>
                <th>Fecha de ingreso</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var h in Model)
            {
                var badge = h.EstadoHabitacion switch
                {
                    "Disponible" => "bg-success",
                    "Ocupada" => "bg-danger",
                    "Mantenimiento" => "bg-warning text-dark",
                    "Limpieza" => "bg-info text-dark",
                    _ => "bg-secondary"
                };

                <tr class="fila-habitacion"
                    data-buscar="@($"{h.NumeroHabitacion} {h.TipoHabitacion} {h.PacienteNombreCompleto}".ToLower())"
                    data-estado="@h.EstadoHabitacion">
                    <td>@h.NumeroHabitacion</td>
                    <td>@h.TipoHabitacion</td>
                    <td><span class="badge @badge">@h.EstadoHabitacion</span></td>
                    <td>@(h.PacienteNombreCompleto ?? "—")</td>
                    <td>@(h.FechaIngreso?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details"
                           asp-route-id="@h.IdHabitacion"><i class="bi bi-eye"></i></a>
                        @if (User.IsInRole("Administrador") || User.IsInRole("Enfermeria"))
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit"
                               asp-route-id="@h.IdHabitacion"><i class="bi bi-pencil"></i></a>
                        }
                        @if (User.IsInRole("Administrador"))
                        {
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete"
                               asp-route-id="@h.IdHabitacion"><i class="bi bi-trash"></i></a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div id="sinResultados" class="text-center text-muted py-4" style="display:none;">
    No se encontraron habitaciones con esos criterios.
</div>

<nav>
    <ul class="pagination justify-content-center" id="paginacion"></ul>
</nav>

@section Scripts {
    <script>
        initTablaFiltro({
            filas: '.fila-habitacion',
            buscador: '#buscador',
            filtros: ['#filtroEstado'],
            contenedorPaginacion: '#paginacion',
            sinResultados: '#sinResultados'
        });
    </script>
}
