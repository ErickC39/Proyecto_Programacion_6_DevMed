@model DevCCSS.Web.Contracts.HabitacionDto
@{
    ViewData["Title"] = "Liberar habitación";
}

<h2 class="mb-3"><i class="bi bi-box-arrow-right"></i> Liberar habitación</h2>

<div class="alert alert-info">
    Habitación <strong>@Model.NumeroHabitacion</strong> — paciente actual:
    <strong>@Model.PacienteNombreCompleto</strong>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Liberar" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>
            <input type="hidden" name="IdHabitacion" value="@Model.IdHabitacion" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Responsable del egreso</label>
                    <select name="IdEmpleadoResponsable" class="form-select">
                        <option value="0">-- Seleccione --</option>
                        @foreach (var empleado in (List<DevCCSS.Web.Contracts.EmpleadoHabitacionDto>)ViewBag.Empleados)
                        {
                            <option value="@empleado.IdEmpleado">@empleado.NombreCompleto</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Fecha de salida</label>
                    <input name="FechaSalida" type="datetime-local" class="form-control"
                           value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                </div>
            </div>

            <div class="mt-4">
                <button class="btn btn-warning" type="submit">
                    <i class="bi bi-box-arrow-right"></i> Liberar
                </button>
                <a class="btn btn-secondary" asp-action="Details" asp-route-id="@Model.IdHabitacion">Cancelar</a>
            </div>
        </form>
    </div>
</div>
