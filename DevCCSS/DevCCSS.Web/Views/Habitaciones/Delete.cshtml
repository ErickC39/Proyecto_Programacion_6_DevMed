@model DevCCSS.Web.Contracts.HabitacionDto
@{
    ViewData["Title"] = "Eliminar habitación";
}

<h2 class="mb-3"><i class="bi bi-trash"></i> Eliminar habitación</h2>

<div class="alert alert-warning">
    Está seguro de eliminar la habitación <strong>@Model.NumeroHabitacion</strong> (@Model.TipoHabitacion)?
</div>

<form asp-action="Delete" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.IdHabitacion" />
    <button class="btn btn-danger" type="submit">
        <i class="bi bi-trash"></i> Eliminar
    </button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>
