@model DevCCSS.Web.Contracts.HabitacionDto
@{
    ViewData["Title"] = "Detalle de la habitación";
    var badge = Model.EstadoHabitacion switch
    {
        "Disponible" => "bg-success",
        "Parcialmente ocupada" => "bg-warning text-dark",
        "Ocupada" => "bg-danger",
        "Mantenimiento" => "bg-warning text-dark",
        "Limpieza" => "bg-info text-dark",
        _ => "bg-secondary"
    };
    var ocupantes = (List<DevCCSS.Web.Contracts.OcupanteHabitacionDto>)ViewBag.Ocupantes;
}

<h2 class="mb-3"><i class="bi bi-door-open"></i> Habitación @Model.NumeroHabitacion</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Número</dt>
            <dd class="col-sm-9">@Model.NumeroHabitacion</dd>

            <dt class="col-sm-3">Tipo</dt>
            <dd class="col-sm-9">@Model.TipoHabitacion</dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9"><span class="badge @badge">@Model.EstadoHabitacion</span></dd>

            <dt class="col-sm-3">Capacidad</dt>
            <dd class="col-sm-9">@Model.OcupantesActuales / @Model.Capacidad paciente@(Model.Capacidad == 1 ? "" : "s")</dd>
        </dl>
    </div>
</div>

<div class="card shadow-sm mt-3">
    <div class="card-header fw-bold">Pacientes alojados actualmente</div>
    <div class="card-body p-0">
        @if (ocupantes.Count == 0)
        {
            <p class="text-muted p-3 mb-0">No hay pacientes alojados en esta habitación.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Paciente</th>
                            <th>Fecha de ingreso</th>
                            <th>Responsable</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in ocupantes)
                        {
                            <tr>
                                <td>@o.PacienteNombreCompleto (@o.PacienteIdentificacion)</td>
                                <td>@o.FechaIngreso.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@o.ResponsableIngreso</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="mt-3">
    @if (User.IsInRole("Administrador") || User.IsInRole("Enfermeria"))
    {
        if (Model.OcupantesActuales < Model.Capacidad)
        {
            <a class="btn btn-success" asp-action="Asignar" asp-route-id="@Model.IdHabitacion">
                <i class="bi bi-person-check"></i> Asignar paciente
            </a>
        }
        if (Model.OcupantesActuales > 0)
        {
            <a class="btn btn-warning" asp-action="Liberar" asp-route-id="@Model.IdHabitacion">
                <i class="bi bi-box-arrow-right"></i> Liberar paciente
            </a>
        }
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.IdHabitacion">
            <i class="bi bi-pencil"></i> Actualizar
        </a>
    }
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
</div>
