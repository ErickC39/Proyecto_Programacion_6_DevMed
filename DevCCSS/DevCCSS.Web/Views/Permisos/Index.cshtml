@model List<DevCCSS.Web.Contracts.RolPermisoDto>
@{
    ViewData["Title"] = "Permisos por rol";
    var porRol = Model.GroupBy(p => p.NombreRol).OrderBy(g => g.Key);
}

<!-- Pantalla de solo lectura: la restriccion real de acceso se aplica en cada modulo con [Authorize(Roles=...)],
     leida desde la tabla Roles_Permisos. -->
<h2 class="mb-3"><i class="bi bi-shield-lock"></i> Permisos por rol</h2>
<p class="text-muted">
    Consulta que puede hacer cada rol dentro del sistema.
</p>

@foreach (var grupo in porRol)
{
    <div class="card shadow-sm mb-3">
        <div class="card-header fw-bold">
            <i class="bi bi-person-badge"></i> @grupo.Key
        </div>
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Modulo</th>
                        <th class="text-center">Ver</th>
                        <th class="text-center">Crear</th>
                        <th class="text-center">Editar</th>
                        <th class="text-center">Eliminar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in grupo.OrderBy(x => x.Modulo))
                    {
                        <tr>
                            <td>@p.Modulo</td>
                            <td class="text-center">@(p.PuedeVer ? Html.Raw("<i class='bi bi-check-lg text-success'></i>") : Html.Raw("<i class='bi bi-dash text-muted'></i>"))</td>
                            <td class="text-center">@(p.PuedeCrear ? Html.Raw("<i class='bi bi-check-lg text-success'></i>") : Html.Raw("<i class='bi bi-dash text-muted'></i>"))</td>
                            <td class="text-center">@(p.PuedeEditar ? Html.Raw("<i class='bi bi-check-lg text-success'></i>") : Html.Raw("<i class='bi bi-dash text-muted'></i>"))</td>
                            <td class="text-center">@(p.PuedeEliminar ? Html.Raw("<i class='bi bi-check-lg text-success'></i>") : Html.Raw("<i class='bi bi-dash text-muted'></i>"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
