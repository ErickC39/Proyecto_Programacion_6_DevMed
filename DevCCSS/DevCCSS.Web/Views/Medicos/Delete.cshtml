@model DevCCSS.Web.Contracts.MedicoDto
@{
    ViewData["Title"] = "Eliminar médico";
}
<h2 class="mb-3 text-danger"><i class="bi bi-exclamation-triangle"></i> Eliminar médico</h2>
<div class="card border-danger shadow-sm"><div class="card-body">
    <p>¿Está seguro de eliminar a <strong>@Model.Nombre @Model.Apellidos</strong> (@Model.Identificacion) como médico?</p>
    <p class="text-muted small">Esto también elimina sus horarios de atención registrados. El empleado no se elimina, solo deja de estar marcado como médico.</p>
    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdMedico" />
        <button class="btn btn-danger" type="submit"><i class="bi bi-trash"></i> Sí, eliminar</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </form>
</div></div>
