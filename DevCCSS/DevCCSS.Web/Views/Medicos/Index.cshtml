@model IEnumerable<DevCCSS.Web.Contracts.MedicoDto>
@{
    ViewData["Title"] = "Médicos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-heart-pulse"></i> Control de Médicos</h2>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Nuevo Médico</a>
</div>

<div class="table-responsive">
    <table id="tablaMedicos" class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Identificación</th>
                <th>Nombre</th>
                <th>Apellidos</th>
                <th>Especialidad</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var medico in Model)
            {
                <tr>
                    <td>@medico.Identificacion</td>
                    <td>@medico.Nombre</td>
                    <td>@medico.Apellidos</td>
                    <td>@medico.Especialidad</td>
                    <td>
                        @if (medico.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@medico.IdMedico"><i class="bi bi-eye"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        new DataTable('#tablaMedicos', {
            language: DATATABLE_IDIOMA_ES,
            columnDefs: [{ targets: -1, orderable: false, searchable: false }],
            order: []
        });
    </script>
}
