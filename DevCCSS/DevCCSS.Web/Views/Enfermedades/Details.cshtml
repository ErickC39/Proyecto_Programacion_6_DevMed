@model DevCCSS.Web.Contracts.EnfermedadDto
@{
    ViewData["Title"] = "Detalle";
    var vinculados = (List<DevCCSS.Web.Contracts.TratamientoEnfermedadDto>)ViewBag.MedicamentosVinculados;
    var disponibles = (List<DevCCSS.Web.Contracts.MedicamentoDto>)ViewBag.MedicamentosDisponibles;
}
<h2 class="mb-3"><i class="bi bi-virus"></i> Detalle</h2>
<div class="card shadow-sm"><div class="card-body">
    <dl class="row mb-0">
            <dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">@Model.Nombre</dd>
            <dt class="col-sm-4">Descripción</dt><dd class="col-sm-8">@Model.Descripcion</dd>
            <dt class="col-sm-4">Recomendaciones generales</dt><dd class="col-sm-8">@Model.RecomendacionesGenerales</dd>
    </dl>
</div></div>
<div class="mt-3">
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.IdEnfermedad">Editar</a>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
</div>

<div class="card shadow-sm mt-4">
    <div class="card-header fw-bold"><i class="bi bi-capsule"></i> Medicamentos indicados para esta enfermedad</div>
    <div class="card-body">
        <table class="table table-striped align-middle mb-3">
            <thead class="table-light">
                <tr>
                    <th>Medicamento</th>
                    <th>Observación específica</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!vinculados.Any())
                {
                    <tr><td colspan="3" class="text-center text-muted py-3">No hay medicamentos vinculados todavía.</td></tr>
                }
                @foreach (var v in vinculados)
                {
                    <tr>
                        <td>@v.NombreMedicamento</td>
                        <td>@v.ObservacionEspecifica</td>
                        <td class="text-end">
                            <form asp-action="QuitarMedicamento" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idEnfermedad" value="@Model.IdEnfermedad" />
                                <input type="hidden" name="idMedicamento" value="@v.IdMedicamento" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Quitar este medicamento de la enfermedad?');">
                                    <i class="bi bi-x-lg"></i> Quitar
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (disponibles.Any())
        {
            <form asp-action="AsignarMedicamento" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idEnfermedad" value="@Model.IdEnfermedad" />
                <div class="col-sm-4">
                    <label class="form-label">Medicamento</label>
                    <select name="idMedicamento" class="form-select" required>
                        @foreach (var m in disponibles)
                        {
                            <option value="@m.IdMedicamento">@m.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-sm-6">
                    <label class="form-label">Observación específica (opcional)</label>
                    <input type="text" name="observacion" class="form-control" maxlength="255" />
                </div>
                <div class="col-sm-2">
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-plus-lg"></i> Vincular</button>
                </div>
            </form>
        }
        else
        {
            <p class="text-muted mb-0">Todos los medicamentos del catálogo ya están vinculados a esta enfermedad.</p>
        }
    </div>
</div>
