@model List<DevCCSS.Web.Contracts.EnfermedadDto>
@{
    ViewData["Title"] = "Enfermedades";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-virus"></i> Enfermedades</h2>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Nuevo</a>
</div>

<!-- Buscador dinamico -->
<div class="mb-3">
    <input type="text" id="buscador" class="form-control"
           placeholder="Buscar por nombre o descripción..." />
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th>Recomendaciones generales</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var x in Model)
        {
            <tr class="fila-enfermedad" data-buscar="@($"{x.Nombre} {x.Descripcion}".ToLower())">
                <td>@x.Nombre</td>
                <td>@x.Descripcion</td>
                <td>@x.RecomendacionesGenerales</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@x.IdEnfermedad"><i class="bi bi-eye"></i></a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.IdEnfermedad"><i class="bi bi-pencil"></i></a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@x.IdEnfermedad"><i class="bi bi-trash"></i></a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div id="sinResultados" class="text-center text-muted py-4" style="display:none;">
    No se encontraron enfermedades con esa búsqueda.
</div>

<nav>
    <ul class="pagination justify-content-center" id="paginacion"></ul>
</nav>

@section Scripts {
    <script>
        initTablaFiltro({
            filas: '.fila-enfermedad',
            buscador: '#buscador',
            contenedorPaginacion: '#paginacion',
            sinResultados: '#sinResultados'
        });
    </script>
}
