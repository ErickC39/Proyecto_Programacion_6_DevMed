@model DevCCSS.Web.Contracts.UsuarioDto
@{
    ViewData["Title"] = "Nuevo usuario";
}
<h2 class="mb-3"><i class="bi bi-person-plus"></i> Nuevo usuario</h2>
<div class="card shadow-sm"><div class="card-body">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger small mb-3"></div>
        <partial name="_Form" model="Model" />
        <div class="row g-3 mt-1">
            <div class="col-md-6">
                <label class="form-label">Contraseña</label>
                <input asp-for="Password" type="password" class="form-control" />
                <div class="form-text">Minimo 8 caracteres, con al menos una letra y un numero.</div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
        </div>
        <div class="mt-4">
            <button class="btn btn-primary" type="submit"><i class="bi bi-save"></i> Guardar</button>
            <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
