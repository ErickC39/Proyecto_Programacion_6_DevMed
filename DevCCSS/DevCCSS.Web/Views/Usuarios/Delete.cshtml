@model DevCCSS.Web.Contracts.UsuarioDto
@{
    ViewData["Title"] = "Eliminar usuario";
}
<h2 class="mb-3 text-danger"><i class="bi bi-exclamation-triangle"></i> Eliminar usuario</h2>
<div class="card border-danger shadow-sm"><div class="card-body">
    <p>Estás seguro de eliminar este usuario?</p>
    <p><strong>@Model.Nombre</strong> (@Model.Username · @Model.Rol)</p>
    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdUsuario" />
        <button class="btn btn-danger" type="submit"><i class="bi bi-trash"></i> Sí, eliminar</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </form>
</div></div>
