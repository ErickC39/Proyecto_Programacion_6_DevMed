@model List<DevCCSS.Web.Contracts.UsuarioDto>
@{
    ViewData["Title"] = "Usuarios";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-people-fill"></i> Usuarios</h2>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Nuevo usuario</a>
</div>

<!-- Buscador dinamico -->
<div class="row g-2 mb-3">
    <div class="col-md-6">
        <input type="text" id="buscador" class="form-control" placeholder="Buscar por usuario..." />
    </div>
    <div class="col-md-3">
        <select id="filtroRol" class="form-select" data-campo="rol">
            <option value="">Todos los roles</option>
            @foreach (var rol in Model.Where(u => !string.IsNullOrEmpty(u.Rol)).Select(u => u.Rol).Distinct().OrderBy(x => x))
            {
                <option value="@rol">@rol</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <select id="filtroEstado" class="form-select" data-campo="estado">
            <option value="">Todos los estados</option>
            <option value="activo">Activo</option>
            <option value="inactivo">Inactivo</option>
        </select>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Usuario</th>
                <th>Rol</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var u in Model)
        {
            <tr class="fila-usuario"
                data-buscar="@u.Username.ToLower()"
                data-rol="@u.Rol"
                data-estado="@(u.Activo ? "activo" : "inactivo")">
                <td>@u.Username</td>
                <td>@u.Rol</td>
                <td>
                    @if (u.Activo) { <span class="badge bg-success">Activo</span> }
                    else { <span class="badge bg-secondary">Inactivo</span> }
                </td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@u.IdUsuario"><i class="bi bi-eye"></i></a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@u.IdUsuario"><i class="bi bi-pencil"></i></a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@u.IdUsuario"><i class="bi bi-trash"></i></a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div id="sinResultados" class="text-center text-muted py-4" style="display:none;">
    No se encontraron usuarios con esa busqueda.
</div>

<nav>
    <ul class="pagination justify-content-center" id="paginacion"></ul>
</nav>

@section Scripts {
    <script>
        initTablaFiltro({
            filas: '.fila-usuario',
            buscador: '#buscador',
            filtros: ['#filtroRol', '#filtroEstado'],
            contenedorPaginacion: '#paginacion',
            sinResultados: '#sinResultados'
        });
    </script>
}
