@model DevCCSS.Web.Contracts.RegistrarNacimientoDto
@{
    ViewData["Title"] = "Registrar nacimiento";
    string[] escalaApariencia = { "Cianótico / pálido", "Acrocianosis (manos/pies azules)", "Rosado completo" };
    string[] escalaPulso = { "Ausente", "Menor a 100 lpm", "Mayor a 100 lpm" };
    string[] escalaGesto = { "Sin respuesta", "Mueca / gesto", "Llanto vigoroso / tos" };
    string[] escalaActividad = { "Flácido", "Alguna flexión", "Movimiento activo" };
    string[] escalaRespiracion = { "Ausente", "Débil / irregular", "Buena / llanto fuerte" };
}
<h2 class="mb-3"><i class="bi bi-heart-pulse"></i> Registrar nacimiento</h2>

<form asp-action="Registrar" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

    <div class="card shadow-sm mb-3">
        <div class="card-header fw-bold"><i class="bi bi-person-vcard"></i> Datos del recién nacido</div>
        <div class="card-body">
            <div class="alert alert-info small">
                <i class="bi bi-info-circle"></i> La identificación clínica se genera automáticamente al guardar (formato NAC-AAAA-MM-DD-###).
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nombre</label>
                    <input asp-for="Nombre" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Apellidos</label>
                    <input asp-for="Apellidos" class="form-control" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Fecha de nacimiento</label>
                    <input asp-for="FechaNacimiento" type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="FechaNacimiento" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Género</label>
                    <select asp-for="IdSexoBiologico" class="form-select">
                        <option value="">-- Seleccione --</option>
                        @foreach (var s in (List<DevCCSS.Web.Contracts.SexoBiologicoDto>)ViewBag.SexosBiologicos)
                        {
                            <option value="@s.IdSexoBiologico">@s.Descripcion</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Tipo de sangre</label>
                    <select asp-for="IdTipoSangre" class="form-select">
                        <option value="">-- Seleccione --</option>
                        @foreach (var t in (List<DevCCSS.Web.Contracts.TipoSangreDto>)ViewBag.TiposSangre)
                        {
                            <option value="@t.IdTipoSangre">@t.Descripcion</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Madre (opcional)</label>
                    <input type="text" id="filtroMadre" class="form-control form-control-sm mb-1" placeholder="Buscar madre..." />
                    <select asp-for="IdMadre" class="form-select">
                        <option value="">-- Sin vincular --</option>
                        @foreach (var m in (List<DevCCSS.Web.Contracts.PacienteDto>)ViewBag.Madres)
                        {
                            <option value="@m.IdPaciente">@m.Nombre @m.Apellidos (@m.Identificacion)</option>
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label">Peso (kg)</label>
                    <input asp-for="Peso" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Estatura / talla (cm)</label>
                    <input asp-for="Estatura" type="number" step="0.1" min="20" max="60" class="form-control" />
                </div>

                <div class="col-12">
                    <label class="form-label">Antecedentes / observaciones del embarazo</label>
                    <textarea asp-for="AntecedentesMedicos" class="form-control" rows="2"></textarea>
                </div>
                <div class="col-12">
                    <label class="form-label">Alergias</label>
                    <textarea asp-for="Alergias" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header fw-bold"><i class="bi bi-clipboard2-pulse"></i> Escala de Apgar</div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Signo</th>
                            <th style="width:32%">1 minuto</th>
                            <th style="width:32%">5 minutos</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Apgar.Count; i++)
                        {
                            <input type="hidden" asp-for="Apgar[i].Minuto" />
                        }
                        <tr>
                            <td>Apariencia / color</td>
                            @for (int i = 0; i < Model.Apgar.Count; i++)
                            {
                                <td>
                                    <select asp-for="Apgar[i].Apariencia" class="form-select form-select-sm apgar-campo">
                                        @for (int v = 0; v <= 2; v++) { <option value="@v">@v - @escalaApariencia[v]</option> }
                                    </select>
                                </td>
                            }
                        </tr>
                        <tr>
                            <td>Pulso / frecuencia cardíaca</td>
                            @for (int i = 0; i < Model.Apgar.Count; i++)
                            {
                                <td>
                                    <select asp-for="Apgar[i].Pulso" class="form-select form-select-sm apgar-campo">
                                        @for (int v = 0; v <= 2; v++) { <option value="@v">@v - @escalaPulso[v]</option> }
                                    </select>
                                </td>
                            }
                        </tr>
                        <tr>
                            <td>Gesto / irritabilidad refleja</td>
                            @for (int i = 0; i < Model.Apgar.Count; i++)
                            {
                                <td>
                                    <select asp-for="Apgar[i].GestoRespuesta" class="form-select form-select-sm apgar-campo">
                                        @for (int v = 0; v <= 2; v++) { <option value="@v">@v - @escalaGesto[v]</option> }
                                    </select>
                                </td>
                            }
                        </tr>
                        <tr>
                            <td>Actividad / tono muscular</td>
                            @for (int i = 0; i < Model.Apgar.Count; i++)
                            {
                                <td>
                                    <select asp-for="Apgar[i].Actividad" class="form-select form-select-sm apgar-campo">
                                        @for (int v = 0; v <= 2; v++) { <option value="@v">@v - @escalaActividad[v]</option> }
                                    </select>
                                </td>
                            }
                        </tr>
                        <tr>
                            <td>Respiración</td>
                            @for (int i = 0; i < Model.Apgar.Count; i++)
                            {
                                <td>
                                    <select asp-for="Apgar[i].Respiracion" class="form-select form-select-sm apgar-campo">
                                        @for (int v = 0; v <= 2; v++) { <option value="@v">@v - @escalaRespiracion[v]</option> }
                                    </select>
                                </td>
                            }
                        </tr>
                        <tr class="table-secondary fw-bold">
                            <td>Total</td>
                            @for (int i = 0; i < Model.Apgar.Count; i++)
                            {
                                <td><span id="apgar-total-@i">0</span> / 10</td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header fw-bold"><i class="bi bi-rulers"></i> Examen físico</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Perímetro cefálico (cm)</label>
                    <input asp-for="PerimetroCefalico" type="number" step="0.1" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Perímetro torácico (cm)</label>
                    <input asp-for="PerimetroToracico" type="number" step="0.1" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Temperatura (°C)</label>
                    <input asp-for="Temperatura" type="number" step="0.1" class="form-control" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Coloración de piel</label>
                    <select asp-for="ColoracionPiel" class="form-select">
                        <option value="">-- Seleccione --</option>
                        <option>Rosada</option>
                        <option>Ictericia</option>
                        <option>Cianótica</option>
                        <option>Pálida</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Frecuencia cardíaca (lpm)</label>
                    <input asp-for="FrecuenciaCardiaca" type="number" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Frecuencia respiratoria (rpm)</label>
                    <input asp-for="FrecuenciaRespiratoria" type="number" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Reflejos presentes</label>
                    <input asp-for="Reflejos" class="form-control" placeholder="Ej: Moro, succión, prensión palmar" />
                </div>
                <div class="col-12">
                    <label class="form-label">Observaciones generales del examen</label>
                    <textarea asp-for="ObservacionesGenerales" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header fw-bold"><i class="bi bi-clipboard2-check"></i> Tamizajes neonatales</div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-dark">
                        <tr><th>Tamizaje</th><th style="width:120px">Realizado</th><th>Resultado</th></tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Tamizajes.Count; i++)
                        {
                            <tr>
                                <td>
                                    <input type="hidden" asp-for="Tamizajes[i].TipoTamizaje" />
                                    @Model.Tamizajes[i].TipoTamizaje
                                </td>
                                <td class="text-center">
                                    <input asp-for="Tamizajes[i].Realizado" class="form-check-input" />
                                </td>
                                <td>
                                    <input asp-for="Tamizajes[i].Resultado" class="form-control form-control-sm" placeholder="Normal / requiere seguimiento / valor" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mb-4">
        <button class="btn btn-primary" type="submit"><i class="bi bi-save"></i> Registrar nacimiento</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function recalcularApgar() {
            for (let i = 0; i < @Model.Apgar.Count; i++) {
                const fila = document.querySelectorAll('.apgar-campo');
                let total = 0;
                fila.forEach(sel => {
                    if (sel.name.startsWith('Apgar[' + i + ']')) total += parseInt(sel.value || '0', 10);
                });
                const span = document.getElementById('apgar-total-' + i);
                if (span) span.textContent = total;
            }
        }
        document.querySelectorAll('.apgar-campo').forEach(sel => sel.addEventListener('change', recalcularApgar));
        recalcularApgar();

        initSelectBuscable('#IdMadre', '#filtroMadre');
    </script>
}
