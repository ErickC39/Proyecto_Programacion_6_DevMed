@model DevCCSS.Web.Contracts.NacimientoDetalleDto
@{
    ViewData["Title"] = "Detalle de nacimiento";
    var d = Model.Datos!;
}
<h2 class="mb-3"><i class="bi bi-heart-pulse"></i> Detalle de nacimiento</h2>

<div class="card shadow-sm mb-3">
    <div class="card-header fw-bold">Datos del recién nacido</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Identificación</dt><dd class="col-sm-9">@d.Identificacion</dd>
            <dt class="col-sm-3">Nombre</dt><dd class="col-sm-9">@d.Nombre @d.Apellidos</dd>
            <dt class="col-sm-3">Nacimiento</dt><dd class="col-sm-9">@d.FechaNacimiento.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Género</dt><dd class="col-sm-9">@d.SexoBiologico</dd>
            <dt class="col-sm-3">Tipo de sangre</dt><dd class="col-sm-9">@d.TipoSangre</dd>
            <dt class="col-sm-3">Peso / Estatura</dt><dd class="col-sm-9">@d.Peso kg / @(d.Estatura.HasValue ? $"{d.Estatura.Value * 100:0.#}" : "-") cm</dd>
            <dt class="col-sm-3">Madre</dt><dd class="col-sm-9">@(d.NombreMadre ?? "-")</dd>
        </dl>
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-header fw-bold">Escala de Apgar</div>
    <div class="card-body">
        @if (!Model.Apgar.Any())
        {
            <p class="text-muted mb-0">No se registró Apgar para este nacimiento.</p>
        }
        else
        {
            <table class="table table-bordered mb-0">
                <thead class="table-dark">
                    <tr><th>Minuto</th><th>Apariencia</th><th>Pulso</th><th>Gesto</th><th>Actividad</th><th>Respiración</th><th>Total</th></tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Apgar)
                    {
                        <tr>
                            <td>@a.Minuto</td><td>@a.Apariencia</td><td>@a.Pulso</td><td>@a.GestoRespuesta</td>
                            <td>@a.Actividad</td><td>@a.Respiracion</td>
                            <td class="fw-bold">@a.Total / 10</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="card shadow-sm mb-3">
    <div class="card-header fw-bold">Examen físico</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Perímetro cefálico</dt><dd class="col-sm-9">@(Model.PerimetroCefalico is null ? "-" : $"{Model.PerimetroCefalico} cm")</dd>
            <dt class="col-sm-3">Perímetro torácico</dt><dd class="col-sm-9">@(Model.PerimetroToracico is null ? "-" : $"{Model.PerimetroToracico} cm")</dd>
            <dt class="col-sm-3">Temperatura</dt><dd class="col-sm-9">@(Model.Temperatura is null ? "-" : $"{Model.Temperatura} °C")</dd>
            <dt class="col-sm-3">Frecuencia cardíaca</dt><dd class="col-sm-9">@(Model.FrecuenciaCardiaca is null ? "-" : $"{Model.FrecuenciaCardiaca} lpm")</dd>
            <dt class="col-sm-3">Frecuencia respiratoria</dt><dd class="col-sm-9">@(Model.FrecuenciaRespiratoria is null ? "-" : $"{Model.FrecuenciaRespiratoria} rpm")</dd>
            <dt class="col-sm-3">Coloración de piel</dt><dd class="col-sm-9">@(Model.ColoracionPiel ?? "-")</dd>
            <dt class="col-sm-3">Reflejos</dt><dd class="col-sm-9">@(Model.Reflejos ?? "-")</dd>
            <dt class="col-sm-3">Observaciones</dt><dd class="col-sm-9">@(Model.ObservacionesGenerales ?? "-")</dd>
        </dl>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-bold">Tamizajes neonatales</div>
    <div class="card-body">
        <table class="table mb-0">
            <thead class="table-dark"><tr><th>Tamizaje</th><th>Realizado</th><th>Resultado</th></tr></thead>
            <tbody>
                @foreach (var t in Model.Tamizajes)
                {
                    <tr>
                        <td>@t.TipoTamizaje</td>
                        <td>@(t.Realizado ? "Sí" : "No")</td>
                        <td>@(t.Resultado ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<a class="btn btn-secondary" asp-action="Index">Volver</a>
