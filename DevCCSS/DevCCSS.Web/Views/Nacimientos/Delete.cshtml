@model DevCCSS.Web.Contracts.NacimientoDto
@{
    ViewData["Title"] = "Eliminar nacimiento";
}
<h2 class="mb-3 text-danger"><i class="bi bi-exclamation-triangle"></i> Eliminar registro de nacimiento</h2>

<div class="alert alert-danger">
    Esta acción elimina permanentemente al paciente <strong>@Model.Nombre @Model.Apellidos</strong>
    (@Model.Identificacion) junto con su Apgar, tamizajes y examen físico. No se puede deshacer.
    Si el paciente ya tiene citas, ventas u otros registros clínicos asociados, la eliminación será rechazada.
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Identificación</dt><dd class="col-sm-9">@Model.Identificacion</dd>
            <dt class="col-sm-3">Nombre</dt><dd class="col-sm-9">@Model.Nombre @Model.Apellidos</dd>
            <dt class="col-sm-3">Nacimiento</dt><dd class="col-sm-9">@Model.FechaNacimiento.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Madre</dt><dd class="col-sm-9">@(Model.NombreMadre ?? "-")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="IdPaciente" />
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Confirmar eliminación</button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>
