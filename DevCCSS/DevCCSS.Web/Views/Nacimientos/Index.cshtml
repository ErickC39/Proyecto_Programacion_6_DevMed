@model List<DevCCSS.Web.Contracts.NacimientoDto>
@{
    ViewData["Title"] = "Nacimientos";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-heart-pulse"></i> Recién nacidos</h2>
    <a class="btn btn-primary" asp-action="Registrar"><i class="bi bi-plus-lg"></i> Registrar nacimiento</a>
</div>

<!-- Buscador dinamico -->
<div class="row g-2 mb-3">
    <div class="col-md-8">
        <input type="text" id="buscador" class="form-control"
               placeholder="Buscar por nombre, identificación o madre..." />
    </div>
    <div class="col-md-4">
        <select id="filtroSexo" class="form-select" data-campo="sexo">
            <option value="">Todos los géneros</option>
            @foreach (var sexo in Model.Where(n => !string.IsNullOrEmpty(n.SexoBiologico))
                                        .Select(n => n.SexoBiologico).Distinct().OrderBy(x => x))
            {
                <option value="@sexo">@sexo</option>
            }
        </select>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Identificación</th>
                <th>Nombre</th>
                <th>Nacimiento</th>
                <th>Género</th>
                <th>Sangre</th>
                <th>Madre</th>
                <th>Apgar (1'/5')</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var n in Model)
            {
                <tr class="fila-nacimiento"
                    data-buscar="@($"{n.Nombre} {n.Apellidos} {n.Identificacion} {n.NombreMadre}".ToLower())"
                    data-sexo="@n.SexoBiologico">
                    <td>@n.Identificacion</td>
                    <td>@n.Nombre @n.Apellidos</td>
                    <td>@n.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                    <td>@n.SexoBiologico</td>
                    <td>@n.TipoSangre</td>
                    <td>@(string.IsNullOrEmpty(n.NombreMadre) ? "-" : n.NombreMadre)</td>
                    <td>@(n.Apgar1Min?.ToString() ?? "-") / @(n.Apgar5Min?.ToString() ?? "-")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@n.IdPaciente"><i class="bi bi-eye"></i></a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@n.IdPaciente"><i class="bi bi-pencil"></i></a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@n.IdPaciente"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div id="sinResultados" class="text-center text-muted py-4" style="display:none;">
    No se encontraron nacimientos con esa búsqueda.
</div>

<nav>
    <ul class="pagination justify-content-center" id="paginacion"></ul>
</nav>

@section Scripts {
    <script>
        initTablaFiltro({
            filas: '.fila-nacimiento',
            buscador: '#buscador',
            filtros: ['#filtroSexo'],
            contenedorPaginacion: '#paginacion',
            sinResultados: '#sinResultados'
        });
    </script>
}
