@model List<DevCCSS.Web.Contracts.PacienteDto>
@{
    ViewData["Title"] = "Pacientes";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-people"></i> Pacientes</h2>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Nuevo paciente</a>
</div>

<!-- Buscador dinamico -->
<div class="row g-2 mb-3">
    <div class="col-md-8">
        <input type="text" id="buscador" class="form-control"
               placeholder="Buscar por nombre o identificacion..." />
    </div>
    <div class="col-md-4">
        <select id="filtroSangre" class="form-select" data-campo="sangre">
            <option value="">Todos los tipos de sangre</option>
            @foreach (var tipo in Model.Where(p => !string.IsNullOrEmpty(p.TipoSangre))
                                       .Select(p => p.TipoSangre).Distinct().OrderBy(x => x))
            {
                <option value="@tipo">@tipo</option>
            }
        </select>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle" id="tablaPacientes">
        <thead class="table-dark">
            <tr>
                <th>Identificacion</th>
                <th>Nombre completo</th>
                <th>Nacimiento</th>
                <th>Genero</th>
                <th>Sangre</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr class="fila-paciente"
                    data-buscar="@($"{p.Nombre} {p.Apellidos} {p.Identificacion}".ToLower())"
                    data-sangre="@p.TipoSangre">
                    <td>@p.Identificacion</td>
                    <td>@p.Nombre @p.Apellidos</td>
                    <td>@p.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                    <td>@p.SexoBiologico</td>
                    <td>@p.TipoSangre</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@p.IdPaciente"><i class="bi bi-eye"></i></a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.IdPaciente"><i class="bi bi-pencil"></i></a>
                        <a class="btn btn-sm btn-outline-success" asp-action="Expediente" asp-route-id="@p.IdPaciente" title="Expediente"><i class="bi bi-clipboard2-pulse"></i></a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@p.IdPaciente"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Mensaje cuando no hay resultados -->
<div id="sinResultados" class="text-center text-muted py-4" style="display:none;">
    No se encontraron pacientes con esa busqueda.
</div>

<!-- Paginacion -->
<nav>
    <ul class="pagination justify-content-center" id="paginacion"></ul>
</nav>

@section Scripts {
    <script>
        initTablaFiltro({
            filas: '.fila-paciente',
            buscador: '#buscador',
            filtros: ['#filtroSangre'],
            contenedorPaginacion: '#paginacion',
            sinResultados: '#sinResultados'
        });
    </script>
}