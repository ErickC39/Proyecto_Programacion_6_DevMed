@model DevCCSS.Web.Contracts.ExpedienteDto
@{
    ViewData["Title"] = "Expediente médico";
}
<h2 class="mb-1"><i class="bi bi-clipboard2-pulse"></i> Expediente médico</h2>
<p class="text-muted">Paciente: <strong>@ViewData["NombrePaciente"]</strong></p>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Expediente" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IdPaciente" />
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Tipo de sangre</label>
                    <select asp-for="IdTipoSangre" class="form-select">
                        <option value="">-- Seleccione --</option>
                        @foreach (var t in (List<DevCCSS.Web.Contracts.TipoSangreDto>)ViewBag.TiposSangre)
                        {
                            <option value="@t.IdTipoSangre">@t.Descripcion</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Peso (kg)</label>
                    <input asp-for="Peso" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Estatura (m)</label>
                    <input asp-for="Estatura" type="number" step="0.01" class="form-control" />
                </div>
                <div class="col-12">
                    <label class="form-label">Antecedentes médicos</label>
                    <textarea asp-for="AntecedentesMedicos" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-12">
                    <label class="form-label">Alergias</label>
                    <textarea asp-for="Alergias" class="form-control" rows="2"></textarea>
                </div>
            </div>

            <div class="mt-4">
                <button class="btn btn-primary" type="submit"><i class="bi bi-save"></i> Guardar expediente</button>
                <a class="btn btn-secondary" asp-action="Index">Volver</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong><i class="bi bi-clipboard2-pulse"></i> Exámenes médicos</strong>
        @if (User.IsInRole("Administrador") || User.IsInRole("Medico"))
        {
            <a class="btn btn-sm btn-primary"
               asp-controller="ExamenesMedicos"
               asp-action="Create"
               asp-route-idPaciente="@Model.IdPaciente">
                <i class="bi bi-plus-lg"></i> Solicitar examen
            </a>
        }
    </div>
    <div class="card-body p-0">
        @{
            var examenes = ViewBag.ExamenesMedicos as List<DevCCSS.Web.Contracts.ExamenMedicoDto>
                ?? new List<DevCCSS.Web.Contracts.ExamenMedicoDto>();
        }
        @if (examenes.Count == 0)
        {
            <p class="text-muted p-3 mb-0">El paciente no tiene exámenes médicos registrados.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Tipo</th>
                            <th>Médico</th>
                            <th>Estado</th>
                            <th class="text-end">Detalle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var examen in examenes)
                        {
                            <tr>
                                <td>@examen.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@examen.TipoExamen</td>
                                <td>@examen.MedicoNombreCompleto</td>
                                <td>@examen.EstadoExamen</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-controller="ExamenesMedicos"
                                       asp-action="Details"
                                       asp-route-id="@examen.IdExamenMedico">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
