@model DevCCSS.Web.Contracts.MedicamentoDto
@{
    ViewData["Title"] = "Detalle del medicamento";
}
<h2 class="mb-3"><i class="bi bi-capsule"></i> @Model.Nombre</h2>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.Nombre</dd>
            <dt class="col-sm-3">Indicaciones de uso</dt>
            <dd class="col-sm-9">@Model.IndicacionesUso</dd>
            <dt class="col-sm-3">Restricciones</dt>
            <dd class="col-sm-9">@Model.Restricciones</dd>
            <dt class="col-sm-3">Horas de aplicación</dt>
            <dd class="col-sm-9">@Model.HorasAplicacionRecomendada</dd>
            <dt class="col-sm-3">Stock</dt>
            <dd class="col-sm-9">
                @if (!Model.CantidadStock.HasValue)
                {
                    <span class="text-muted">Sin vincular a inventario (no disponible para la venta)</span>
                }
                else if (Model.CantidadStock.Value <= 0)
                {
                    <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Sin stock</span>
                }
                else
                {
                    <span class="badge bg-success">@Model.CantidadStock disponibles</span>
                    @if (Model.PrecioUnitario.HasValue)
                    {
                        <span class="text-muted small ms-2">₡@Model.PrecioUnitario.Value.ToString("N2")</span>
                    }
                }
            </dd>
        </dl>
    </div>
</div>
<div class="mt-3">
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.IdMedicamento">Editar</a>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
</div>