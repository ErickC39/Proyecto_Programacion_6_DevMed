@model List<DevCCSS.Web.Contracts.MedicamentoDto>
@{
    ViewData["Title"] = "Medicamentos";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-capsule"></i> Medicamentos</h2>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Nuevo medicamento</a>
</div>

<!-- Buscador dinamico -->
<div class="mb-3">
    <input type="text" id="buscador" class="form-control"
           placeholder="Buscar por nombre o indicaciones..." />
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nombre</th>
                <th>Indicaciones de uso</th>
                <th>Horas de aplicación</th>
                <th>Stock</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr class="fila-medicamento"
                    data-buscar="@($"{m.Nombre} {m.IndicacionesUso}".ToLower())">
                    <td>@m.Nombre</td>
                    <td>@m.IndicacionesUso</td>
                    <td>@m.HorasAplicacionRecomendada</td>
                    <td>
                        @if (!m.CantidadStock.HasValue)
                        {
                            <span class="text-muted small">Sin vincular a inventario</span>
                        }
                        else if (m.CantidadStock.Value <= 0)
                        {
                            <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Sin stock</span>
                        }
                        else
                        {
                            <span class="badge bg-success">@m.CantidadStock disponibles</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@m.IdMedicamento"><i class="bi bi-eye"></i></a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@m.IdMedicamento"><i class="bi bi-pencil"></i></a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@m.IdMedicamento"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div id="sinResultados" class="text-center text-muted py-4" style="display:none;">
    No se encontraron medicamentos con esa búsqueda.
</div>

<nav>
    <ul class="pagination justify-content-center" id="paginacion"></ul>
</nav>

@section Scripts {
    <script>
        initTablaFiltro({
            filas: '.fila-medicamento',
            buscador: '#buscador',
            contenedorPaginacion: '#paginacion',
            sinResultados: '#sinResultados'
        });
    </script>
}