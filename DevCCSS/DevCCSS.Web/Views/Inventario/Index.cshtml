@model List<DevCCSS.Web.Contracts.ProductoDto>
@{
    ViewData["Title"] = "Inventario";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-box-seam"></i> Inventario</h2>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Nuevo</a>
</div>

<!-- Buscador dinamico -->
<div class="row g-2 mb-3">
    <div class="col-md-8">
        <input type="text" id="buscador" class="form-control"
               placeholder="Buscar por nombre o descripción..." />
    </div>
    <div class="col-md-4">
        <select id="filtroTipo" class="form-select" data-campo="tipo">
            <option value="">Todos</option>
            <option value="insumo">Insumo médico</option>
            <option value="producto">Producto de venta</option>
        </select>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nombre del producto</th>
                <th>Descripción</th>
                <th>Stock</th>
                <th>Precio unitario</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var x in Model)
        {
            <tr class="fila-producto"
                data-buscar="@($"{x.NombreProducto} {x.Descripcion}".ToLower())"
                data-tipo="@(x.EsInsumoMedico ? "insumo" : "producto")">
                <td>@x.NombreProducto</td>
                <td>@x.Descripcion</td>
                <td>@x.CantidadStock</td>
                <td>@x.PrecioUnitario</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@x.IdProducto"><i class="bi bi-eye"></i></a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.IdProducto"><i class="bi bi-pencil"></i></a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@x.IdProducto"><i class="bi bi-trash"></i></a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div id="sinResultados" class="text-center text-muted py-4" style="display:none;">
    No se encontraron productos con esa búsqueda.
</div>

<nav>
    <ul class="pagination justify-content-center" id="paginacion"></ul>
</nav>

@section Scripts {
    <script>
        initTablaFiltro({
            filas: '.fila-producto',
            buscador: '#buscador',
            filtros: ['#filtroTipo'],
            contenedorPaginacion: '#paginacion',
            sinResultados: '#sinResultados'
        });
    </script>
}
