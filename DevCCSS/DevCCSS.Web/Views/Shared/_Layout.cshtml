<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hospital DevMed</title>
    <link rel="icon" type="image/png" href="~/imagenes/logo_devmed.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://cdn.datatables.net/2.1.8/css/dataTables.bootstrap5.min.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <script>
        (function () {
            var t = localStorage.getItem('devmed-theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', t);
        })();
    </script>
</head>
<body>
    @if (ViewData["OcultarNavbar"] == null)
    {
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <img src="~/imagenes/logo_devmed.png" asp-append-version="true" alt="DevMed" height="60" />
                    DevMed
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="nav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto">
                            @if (User.IsInRole("Administrador") || User.IsInRole("Medico") || User.IsInRole("Enfermeria") || User.IsInRole("Recepcionista"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Pacientes" asp-action="Index"><i class="bi bi-people"></i> Pacientes</a></li>
                            }
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-people-fill"></i> Personal</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Empleados" asp-action="Index"><i class="bi bi-person-badge"></i> Empleados</a></li>
                                        <li><a class="dropdown-item" asp-controller="Medicos" asp-action="Index"><i class="bi bi-heart-pulse"></i> Médicos</a></li>
                                    </ul>
                                </li>
                            }
                            @if (User.IsInRole("Administrador") || User.IsInRole("Medico") || User.IsInRole("Enfermeria") || User.IsInRole("Recepcionista"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Citas" asp-action="Index"><i class="bi bi-calendar2-check"></i> Citas</a></li>
                            }
                            @if (User.IsInRole("Administrador") || User.IsInRole("Medico") || User.IsInRole("Enfermeria"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-hospital"></i> Clínico</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Enfermedades" asp-action="Index"><i class="bi bi-virus"></i> Enfermedades</a></li>
                                        <li><a class="dropdown-item" asp-controller="Medicamentos" asp-action="Index"><i class="bi bi-capsule"></i> Medicamentos</a></li>
                                        <li><a class="dropdown-item" asp-controller="ExamenesMedicos" asp-action="Index"><i class="bi bi-clipboard2-pulse"></i> Exámenes médicos</a></li>
                                        <li><a class="dropdown-item" asp-controller="Nacimientos" asp-action="Index"><i class="bi bi-clipboard2-heart"></i> Nacimientos</a></li>
                                        <li><a class="dropdown-item" asp-controller="Habitaciones" asp-action="Index"><i class="bi bi-door-open"></i> Habitaciones</a></li>
                                    </ul>
                                </li>
                            }
                            @if (User.IsInRole("Administrador") || User.IsInRole("Facturacion"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-shop"></i> Comercial</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Inventario" asp-action="Index"><i class="bi bi-box-seam"></i> Inventario</a></li>
                                        <li><a class="dropdown-item" asp-controller="Ventas" asp-action="Index"><i class="bi bi-receipt"></i> Ventas / Facturación</a></li>
                                    </ul>
                                </li>
                            }
                            @if (User.IsInRole("Administrador") || User.IsInRole("Recepcionista"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Visitantes" asp-action="Index"><i class="bi bi-person-lines-fill"></i> Visitantes</a></li>
                            }
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown"><i class="bi bi-shield-lock"></i> Admin</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-person-vcard"></i> Usuarios y Roles</a></li>
                                        <li><a class="dropdown-item" asp-controller="Permisos" asp-action="Index"><i class="bi bi-key"></i> Permisos</a></li>
                                        <li><a class="dropdown-item" asp-controller="Bitacora" asp-action="Index"><i class="bi bi-journal-text"></i> Bitácoras</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>
                        <div class="d-flex align-items-center gap-2">
                            <button id="themeToggle" class="btn btn-outline-light btn-sm" type="button" title="Modo oscuro">
                                <i class="bi bi-moon-stars"></i>
                            </button>
                            <span class="text-light small">
                                <i class="bi bi-person-circle"></i> @(User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? User.Identity.Name)
                            </span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-outline-light btn-sm" type="submit">Salir</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Iniciar sesión</a></li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    }

    @if (ViewData["OcultarNavbar"] == null)
    {
        <main class="container py-4">
            @if (TempData["Ok"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Ok"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @RenderBody()
        </main>

        <footer class="text-center text-muted small py-3 border-top">
            <div class="d-flex flex-wrap justify-content-center gap-3 mb-2">
                <a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="AcercaDe">
                    <i class="bi bi-info-circle"></i> Acerca de
                </a>
                <a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="Ayuda">
                    <i class="bi bi-question-circle"></i> Ayuda
                </a>
                <a class="link-secondary text-decoration-none" asp-controller="Home" asp-action="Terminos">
                    <i class="bi bi-file-text"></i> Términos y condiciones
                </a>
            </div>
            <div>&copy; <span id="year"></span> Hospital DevMed. Todos los derechos reservados.</div>
        </footer>
    }
    else
    {
        @RenderBody()
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/2.1.8/js/dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/2.1.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="~/js/tabla-filtro.js" asp-append-version="true"></script>
    <script>
        (function () {
            var btn = document.getElementById('themeToggle');
            if (!btn) return;
            var icon = btn.querySelector('i');
            function actualizarIcono() {
                var oscuro = document.documentElement.getAttribute('data-bs-theme') === 'dark';
                icon.className = oscuro ? 'bi bi-sun' : 'bi bi-moon-stars';
                btn.title = oscuro ? 'Modo claro' : 'Modo oscuro';
            }
            actualizarIcono();
            btn.addEventListener('click', function () {
                var nuevo = document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
                document.documentElement.setAttribute('data-bs-theme', nuevo);
                localStorage.setItem('devmed-theme', nuevo);
                actualizarIcono();
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
