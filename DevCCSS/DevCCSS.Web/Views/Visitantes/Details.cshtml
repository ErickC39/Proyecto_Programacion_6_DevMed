@model DevCCSS.Web.Contracts.VisitanteDto
@{
    ViewData["Title"] = "Detalle";
}
<h2 class="mb-3"><i class="bi bi-door-open"></i> Detalle</h2>
<div class="card shadow-sm"><div class="card-body">
    <dl class="row mb-0">
            <dt class="col-sm-4">Identificación del visitante</dt><dd class="col-sm-8">@Model.Identificacion</dd>
            <dt class="col-sm-4">Nombre completo</dt><dd class="col-sm-8">@Model.NombreCompleto</dd>
            <dt class="col-sm-4">Paciente visitado</dt><dd class="col-sm-8">@Model.PacienteVisitado</dd>
            <dt class="col-sm-4">Fecha y hora de entrada</dt><dd class="col-sm-8">@Model.FechaHoraEntrada.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-sm-4">Fecha y hora de salida</dt><dd class="col-sm-8">@(Model.FechaHoraSalida.HasValue ? Model.FechaHoraSalida.Value.ToString("dd/MM/yyyy HH:mm") : "")</dd>
            <dt class="col-sm-4">Minutos de estancia</dt><dd class="col-sm-8">@Model.MinutosEstancia</dd>
    </dl>
</div></div>
<div class="mt-3">
    @if (!Model.FechaHoraSalida.HasValue)
    {
        <form asp-action="RegistrarSalida" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.IdVisita" />
            <button type="submit" class="btn btn-success" onclick="return confirm('¿Registrar la salida de este visitante ahora?');">
                <i class="bi bi-box-arrow-right"></i> Registrar salida
            </button>
        </form>
    }
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.IdVisita">Editar</a>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
</div>
