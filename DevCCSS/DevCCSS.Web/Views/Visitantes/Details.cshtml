@model DevCCSS.Web.Contracts.VisitanteDto
@{
    ViewData["Title"] = "Detalle";
}
<h2 class="mb-3"><i class="bi bi-door-open"></i> Detalle</h2>
<div class="card shadow-sm"><div class="card-body">
    <dl class="row mb-0">
            <dt class="col-sm-4">Identificación del visitante</dt><dd class="col-sm-8">@Model.Identificacion</dd>
            <dt class="col-sm-4">Nombre completo</dt><dd class="col-sm-8">@Model.NombreCompleto</dd>
            <dt class="col-sm-4">Paciente a visitar</dt><dd class="col-sm-8">@Model.IdPacienteAVisitar</dd>
            <dt class="col-sm-4">Paciente visitado</dt><dd class="col-sm-8">@Model.PacienteVisitado</dd>
            <dt class="col-sm-4">Fecha y hora de entrada</dt><dd class="col-sm-8">@Model.FechaHoraEntrada</dd>
            <dt class="col-sm-4">Fecha y hora de salida</dt><dd class="col-sm-8">@Model.FechaHoraSalida</dd>
            <dt class="col-sm-4">Minutos de estancia</dt><dd class="col-sm-8">@Model.MinutosEstancia</dd>
    </dl>
</div></div>
<div class="mt-3">
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.IdVisita">Editar</a>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
</div>
