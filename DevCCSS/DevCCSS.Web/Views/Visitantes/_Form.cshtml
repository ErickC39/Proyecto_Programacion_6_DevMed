@model DevCCSS.Web.Contracts.VisitanteDto

<div class="row g-3">
    <input type="hidden" asp-for="IdVisita" />
    @if (Model.IdVisita > 0)
    {
        <div class="col-md-6">
            <label class="form-label">Identificación del visitante</label>
            <input asp-for="Identificacion" class="form-control" />
            <span asp-validation-for="Identificacion" class="text-danger small"></span>
        </div>
    }
    else
    {
        <div class="col-md-6">
            <label class="form-label">Identificación del visitante</label>
            <input class="form-control" value="Se asignará automáticamente (VIS-###)" disabled />
        </div>
    }
    <div class="col-md-6">
        <label class="form-label">Nombre completo</label>
        <input asp-for="NombreCompleto" class="form-control" />
        <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        @{
            var pacientesVisita = (List<DevCCSS.Web.Contracts.PacienteDto>)ViewBag.Pacientes;
            var pacienteVisitaActual = pacientesVisita.FirstOrDefault(p => p.IdPaciente == Model.IdPacienteAVisitar);
        }
        <label class="form-label">Paciente a visitar</label>
        <input type="text" id="buscarPacienteVisitar" class="form-control" list="listaPacientesVisitar"
               value="@(pacienteVisitaActual != null ? $"{pacienteVisitaActual.Nombre} {pacienteVisitaActual.Apellidos} ({pacienteVisitaActual.Identificacion})" : "")"
               placeholder="Buscar por nombre o identificación..." autocomplete="off" />
        <datalist id="listaPacientesVisitar">
            @foreach (var p in pacientesVisita)
            {
                <option data-id="@p.IdPaciente" value="@($"{p.Nombre} {p.Apellidos} ({p.Identificacion})")"></option>
            }
        </datalist>
        <input type="hidden" asp-for="IdPacienteAVisitar" id="hdnIdPacienteVisitar" />
    </div>
    <div class="col-md-6">
        <label class="form-label">Fecha y hora de entrada</label>
        <input asp-for="FechaHoraEntrada" type="datetime-local" class="form-control" value="@Model.FechaHoraEntrada.ToString("yyyy-MM-ddTHH:mm")" />
        <span asp-validation-for="FechaHoraEntrada" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label class="form-label">Fecha y hora de salida</label>
        <input asp-for="FechaHoraSalida" type="datetime-local" class="form-control" value="@(Model.FechaHoraSalida.HasValue ? Model.FechaHoraSalida.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
        <span asp-validation-for="FechaHoraSalida" class="text-danger small"></span>
    </div>
</div>
