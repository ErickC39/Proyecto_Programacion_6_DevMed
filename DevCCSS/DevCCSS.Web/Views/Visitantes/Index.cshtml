@model List<DevCCSS.Web.Contracts.VisitanteDto>
@{
    ViewData["Title"] = "Control de Visitantes";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-door-open"></i> Control de Visitantes</h2>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Registrar visita</a>
</div>

<!-- Buscador dinamico -->
<div class="row g-2 mb-3">
    <div class="col-md-8">
        <input type="text" id="buscador" class="form-control"
               placeholder="Buscar por nombre, identificación o paciente visitado..." />
    </div>
    <div class="col-md-4">
        <select id="filtroEstado" class="form-select" data-campo="estado">
            <option value="">Todos</option>
            <option value="dentro">Dentro del hospital</option>
            <option value="salio">Ya salió</option>
        </select>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Identificación del visitante</th>
                <th>Nombre completo</th>
                <th>Paciente visitado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var x in Model)
        {
            <tr class="fila-visitante"
                data-buscar="@($"{x.NombreCompleto} {x.Identificacion} {x.PacienteVisitado}".ToLower())"
                data-estado="@(x.FechaHoraSalida.HasValue ? "salio" : "dentro")">
                <td>@x.Identificacion</td>
                <td>@x.NombreCompleto</td>
                <td>@x.PacienteVisitado</td>
                <td class="text-end">
                    @if (!x.FechaHoraSalida.HasValue)
                    {
                        <form asp-action="RegistrarSalida" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@x.IdVisita" />
                            <button type="submit" class="btn btn-sm btn-outline-success" title="Registrar salida"
                                    onclick="return confirm('¿Registrar la salida de este visitante ahora?');">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    }
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@x.IdVisita"><i class="bi bi-eye"></i></a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.IdVisita"><i class="bi bi-pencil"></i></a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@x.IdVisita"><i class="bi bi-trash"></i></a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div id="sinResultados" class="text-center text-muted py-4" style="display:none;">
    No se encontraron visitantes con esa búsqueda.
</div>

<nav>
    <ul class="pagination justify-content-center" id="paginacion"></ul>
</nav>

@section Scripts {
    <script>
        initTablaFiltro({
            filas: '.fila-visitante',
            buscador: '#buscador',
            filtros: ['#filtroEstado'],
            contenedorPaginacion: '#paginacion',
            sinResultados: '#sinResultados'
        });
    </script>
}
