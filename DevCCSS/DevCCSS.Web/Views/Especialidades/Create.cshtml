@model DevCCSS.Web.Contracts.EspecialidadDto
@{
    ViewData["Title"] = "Nueva especialidad";
}
<h2 class="mb-3"><i class="bi bi-plus-lg"></i> Nueva especialidad</h2>

<div class="card shadow-sm"><div class="card-body">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger small mb-3"></div>

        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <input asp-for="Nombre" class="form-control" autofocus />
            <span asp-validation-for="Nombre" class="text-danger small"></span>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Guardar</button>
            <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
