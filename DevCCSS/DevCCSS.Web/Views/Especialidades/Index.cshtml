@model List<DevCCSS.Web.Contracts.EspecialidadDto>
@{
    ViewData["Title"] = "Especialidades";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-clipboard2-pulse"></i> Especialidades</h2>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Agregar especialidad</a>
</div>

<div class="card shadow-sm"><div class="card-body">
    <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr><th>Nombre</th></tr>
        </thead>
        <tbody>
            @foreach (var e in Model)
            {
                <tr><td>@e.Nombre</td></tr>
            }
        </tbody>
    </table>
</div></div>

<div class="mt-3">
    <a class="btn btn-secondary" asp-controller="Medicos" asp-action="Index">Volver a Médicos</a>
</div>
