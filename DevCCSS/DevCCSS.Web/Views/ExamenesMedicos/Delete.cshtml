@model DevCCSS.Web.Contracts.ExamenMedicoDto
@{
    ViewData["Title"] = "Eliminar examen medico";
}

<h2 class="mb-3"><i class="bi bi-trash"></i> Eliminar examen medico</h2>

<div class="alert alert-warning">
    Esta seguro de eliminar el examen <strong>@Model.TipoExamen</strong> del paciente
    <strong>@Model.PacienteNombreCompleto</strong>?
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Fecha de solicitud</dt>
            <dd class="col-sm-9">@Model.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</dd>
            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">@Model.EstadoExamen</dd>
            <dt class="col-sm-3">Medico</dt>
            <dd class="col-sm-9">@Model.MedicoNombreCompleto</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="@Model.IdExamenMedico" />
    <button class="btn btn-danger" type="submit">
        <i class="bi bi-trash"></i> Eliminar
    </button>
    <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
</form>
