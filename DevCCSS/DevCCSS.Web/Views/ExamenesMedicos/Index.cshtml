@model List<DevCCSS.Web.Contracts.ExamenMedicoDto>
@{
    ViewData["Title"] = "Exámenes médicos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-clipboard2-pulse"></i> Exámenes médicos</h2>
    @if (User.IsInRole("Administrador") || User.IsInRole("Medico"))
    {
        <a class="btn btn-primary" asp-action="Create">
            <i class="bi bi-plus-lg"></i> Solicitar examen
        </a>
    }
</div>

<div class="row g-2 mb-3">
    <div class="col-md-8">
        <input type="text" id="buscador" class="form-control"
               placeholder="Buscar por paciente, médico, identificación o tipo..." />
    </div>
    <div class="col-md-4">
        <select id="filtroEstado" class="form-select" data-campo="estado">
            <option value="">Todos los estados</option>
            @foreach (var estado in Model.Select(x => x.EstadoExamen).Distinct().OrderBy(x => x))
            {
                <option value="@estado">@estado</option>
            }
        </select>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Paciente</th>
                <th>Tipo</th>
                <th>Médico</th>
                <th>Fecha de solicitud</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var examen in Model)
            {
                var badge = examen.EstadoExamen switch
                {
                    "Solicitado" => "bg-secondary",
                    "En proceso" => "bg-warning text-dark",
                    "Completado" => "bg-success",
                    "Cancelado" => "bg-danger",
                    _ => "bg-secondary"
                };

                <tr class="fila-examen"
                    data-buscar="@($"{examen.PacienteNombreCompleto} {examen.PacienteIdentificacion} {examen.MedicoNombreCompleto} {examen.TipoExamen}".ToLower())"
                    data-estado="@examen.EstadoExamen">
                    <td>
                        @examen.PacienteNombreCompleto
                        <small class="text-muted">(@examen.PacienteIdentificacion)</small>
                    </td>
                    <td>@examen.TipoExamen</td>
                    <td>@examen.MedicoNombreCompleto</td>
                    <td>@examen.FechaSolicitud.ToString("dd/MM/yyyy HH:mm")</td>
                    <td><span class="badge @badge">@examen.EstadoExamen</span></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details"
                           asp-route-id="@examen.IdExamenMedico"><i class="bi bi-eye"></i></a>
                        @if (User.IsInRole("Administrador") || User.IsInRole("Medico"))
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit"
                               asp-route-id="@examen.IdExamenMedico"><i class="bi bi-pencil"></i></a>
                        }
                        @if (User.IsInRole("Administrador"))
                        {
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete"
                               asp-route-id="@examen.IdExamenMedico"><i class="bi bi-trash"></i></a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div id="sinResultados" class="text-center text-muted py-4" style="display:none;">
    No se encontraron exámenes médicos con esos criterios.
</div>

<nav>
    <ul class="pagination justify-content-center" id="paginacion"></ul>
</nav>

@section Scripts {
    <script>
        initTablaFiltro({
            filas: '.fila-examen',
            buscador: '#buscador',
            filtros: ['#filtroEstado'],
            contenedorPaginacion: '#paginacion',
            sinResultados: '#sinResultados'
        });
    </script>
}
