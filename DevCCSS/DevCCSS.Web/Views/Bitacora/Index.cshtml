@using DevCCSS.Web.Contracts
@{
    ViewData["Title"] = "Bitácoras";
    var auditoria = (List<BitacoraAuditoriaDto>)ViewBag.Auditoria;
    var errores = (List<BitacoraErrorDto>)ViewBag.Errores;
    
}

<h2 class="mb-3"><i class="bi bi-journal-text"></i> Bitácoras (Auditoría / Errores)</h2>

<ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-auditoria" type="button">
            <i class="bi bi-clock-history"></i> Auditoría (@auditoria.Count)
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-errores" type="button">
            <i class="bi bi-exclamation-triangle"></i> Errores (@errores.Count)
        </button>
    </li>

</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="tab-auditoria">

        <!-- Buscador dinamico -->
        <div class="row g-2 mb-3">
            <div class="col-md-6">
                <input type="text" id="buscadorAuditoria" class="form-control"
                       placeholder="Buscar por usuario, tabla o contenido..." />
            </div>
            <div class="col-md-3">
                <select id="filtroAccion" class="form-select" data-campo="accion">
                    <option value="">Toda acción</option>
                    @foreach (var accion in auditoria.Select(a => a.Accion).Distinct().OrderBy(x => x))
                    {
                        <option value="@accion">@accion</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select id="filtroTabla" class="form-select" data-campo="tabla">
                    <option value="">Toda tabla</option>
                    @foreach (var tabla in auditoria.Select(a => a.TablaAfectada).Distinct().OrderBy(x => x))
                    {
                        <option value="@tabla">@tabla</option>
                    }
                </select>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Fecha</th>
                        <th>Usuario</th>
                        <th>Acción</th>
                        <th>Tabla</th>
                        <th>Antes</th>
                        <th>Después</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in auditoria)
                    {
                        <tr class="fila-auditoria"
                            data-buscar="@($"{a.UsuarioResponsable} {a.TablaAfectada} {a.DetalleRegistroAntiguo} {a.DetalleRegistroNuevo}".ToLower())"
                            data-accion="@a.Accion"
                            data-tabla="@a.TablaAfectada">
                            <td class="text-nowrap">@a.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>@(a.UsuarioResponsable ?? "(sistema)")</td>
                            <td>
                                @{
                                    var badge = a.Accion switch
                                    {
                                        "INSERT" => "bg-success",
                                        "UPDATE" => "bg-info text-dark",
                                        "DELETE" => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badge">@a.Accion</span>
                            </td>
                            <td>@a.TablaAfectada</td>
                            <td><small class="text-muted text-break">@a.DetalleRegistroAntiguo</small></td>
                            <td><small class="text-break">@a.DetalleRegistroNuevo</small></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div id="sinResultadosAuditoria" class="text-center text-muted py-4" style="display:none;">
            No se encontraron registros de auditoría con esa búsqueda.
        </div>

        <nav>
            <ul class="pagination justify-content-center" id="paginacionAuditoria"></ul>
        </nav>
    </div>

    <div class="tab-pane fade" id="tab-errores">

        <!-- Buscador dinamico -->
        <div class="mb-3">
            <input type="text" id="buscadorErrores" class="form-control"
                   placeholder="Buscar por procedimiento o mensaje..." />
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Fecha</th>
                        <th>Procedimiento / Trigger</th>
                        <th>N Error</th>
                        <th>Mensaje</th>
                        <th>Línea</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in errores)
                    {
                        <tr class="fila-error" data-buscar="@($"{e.Procedimiento_Trigger} {e.MensajeError}".ToLower())">
                            <td class="text-nowrap">@e.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>@e.Procedimiento_Trigger</td>
                            <td>@e.NumeroError</td>
                            <td>@e.MensajeError</td>
                            <td>@e.LineaError</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
         

        <div id="sinResultadosErrores" class="text-center text-muted py-4" style="display:none;">
            No se encontraron errores con esa búsqueda.
        </div>

        <nav>
            <ul class="pagination justify-content-center" id="paginacionErrores"></ul>
        </nav>
    </div>
</div>

@section Scripts {
    <script>
        initTablaFiltro({
            filas: '.fila-auditoria',
            buscador: '#buscadorAuditoria',
            filtros: ['#filtroAccion', '#filtroTabla'],
            contenedorPaginacion: '#paginacionAuditoria',
            sinResultados: '#sinResultadosAuditoria'
        });

        initTablaFiltro({
            filas: '.fila-error',
            buscador: '#buscadorErrores',
            contenedorPaginacion: '#paginacionErrores',
            sinResultados: '#sinResultadosErrores'
        });
    </script>
}
