@model DevCCSS.Web.Contracts.CrearVentaDto
@{
    ViewData["Title"] = "Nueva venta";
    var productos = (List<DevCCSS.Web.Contracts.ProductoDto>)ViewBag.Productos;
}
<h2 class="mb-3"><i class="bi bi-cart-plus"></i> Nueva venta</h2>

<form asp-action="Create" method="post" id="formVenta">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger small mb-3"></div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label">Cédula del paciente (opcional)</label>
            <input asp-for="PacienteIdentificacion" class="form-control" placeholder="Dejar vacío si es cliente ocasional" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Método de pago</label>
            <select asp-for="MetodoPago" class="form-select">
                <option value="Efectivo">Efectivo</option>
                <option value="Tarjeta">Tarjeta</option>
                <option value="Sinpe">Sinpe</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Descuento (₡)</label>
            <div class="input-group">
                <input id="txtDescuento" type="number" step="0.01" min="0" class="form-control" value="0" />
                <button type="button" id="btnAplicarDescuento" class="btn btn-outline-secondary">Aplicar</button>
            </div>
            <input asp-for="Descuento" type="hidden" id="DescuentoReal" value="0" />
        </div>
    </div>

    <div class="row g-2 align-items-end mb-2">
        <div class="col-md-6">
            <label class="form-label">Producto</label>
            <select id="selProducto" class="form-select">
                @foreach (var p in productos)
                {
                    <option value="@p.IdProducto" data-precio="@p.PrecioUnitario" data-stock="@p.CantidadStock">
                        @p.NombreProducto — ₡@p.PrecioUnitario.ToString("N2") (stock: @p.CantidadStock)
                    </option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Cantidad</label>
            <input id="txtCantidad" type="number" min="1" value="1" class="form-control" />
        </div>
        <div class="col-md-2">
            <button type="button" id="btnAgregar" class="btn btn-outline-primary w-100">Agregar</button>
        </div>
    </div>

    <table class="table table-sm" id="tablaCarrito">
        <thead><tr><th>Producto</th><th>Cant.</th><th>Precio unit.</th><th>Subtotal</th><th></th></tr></thead>
        <tbody></tbody>
        <tr id="filaVacia"><td colspan="5" class="text-center text-muted py-3">Agregue productos al carrito</td></tr>
    </table>

    <div class="card bg-light border-0 mt-3">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-9 text-end">Subtotal</dt>
                <dd class="col-sm-3 text-end">₡<span id="lblSubtotal">0.00</span></dd>

                <dt class="col-sm-9 text-end">Descuento</dt>
                <dd class="col-sm-3 text-end text-danger">- ₡<span id="lblDescuentoAplicado">0.00</span></dd>

                <dt class="col-sm-9 text-end">Base gravable</dt>
                <dd class="col-sm-3 text-end">₡<span id="lblBaseGravable">0.00</span></dd>

                <dt class="col-sm-9 text-end">Impuesto (IVA 13%)</dt>
                <dd class="col-sm-3 text-end">+ ₡<span id="lblImpuesto">0.00</span></dd>

                <dt class="col-sm-9 text-end fs-5 fw-bold border-top pt-2">Total a pagar</dt>
                <dd class="col-sm-3 text-end fs-5 fw-bold border-top pt-2">₡<span id="lblTotal">0.00</span></dd>
            </dl>
        </div>
    </div>

    <div id="itemsOcultos"></div>

    <div class="mt-3">
        <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Registrar venta</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <script>
        const TASA_IVA = 0.13; // debe coincidir con la tasa fija dentro de sp_Venta_Registrar
        let carrito = [];
        let descuentoAplicado = 0;

        document.getElementById('btnAgregar').addEventListener('click', () => {
            const sel = document.getElementById('selProducto');
            const opt = sel.selectedOptions[0];
            const cantidad = parseInt(document.getElementById('txtCantidad').value);
            const stock = parseInt(opt.dataset.stock);

            if (!cantidad || cantidad < 1) return;
            if (cantidad > stock) { alert('No hay stock suficiente para esa cantidad.'); return; }

            carrito.push({ idProducto: parseInt(sel.value), nombre: opt.text, precio: parseFloat(opt.dataset.precio), cantidad });
            render();
        });

        document.getElementById('btnAplicarDescuento').addEventListener('click', () => {
            const valor = parseFloat(document.getElementById('txtDescuento').value);
            descuentoAplicado = (!isNaN(valor) && valor >= 0) ? valor : 0;
            render();
        });

        function render() {
            const tbody = document.querySelector('#tablaCarrito tbody');
            const filaVacia = document.getElementById('filaVacia');
            tbody.innerHTML = '';
            let subtotal = 0;

            carrito.forEach((item, i) => {
                const lineaSubtotal = item.precio * item.cantidad;
                subtotal += lineaSubtotal;
                tbody.innerHTML += `<tr>
                    <td>${item.nombre}</td><td>${item.cantidad}</td><td>₡${item.precio.toFixed(2)}</td><td>₡${lineaSubtotal.toFixed(2)}</td>
                    <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="quitar(${i})"><i class="bi bi-x"></i></button></td>
                </tr>`;
            });
            filaVacia.style.display = carrito.length === 0 ? '' : 'none';

            // el descuento nunca supera el subtotal ni vuelve el total negativo
            // (misma regla que aplica sp_Venta_Registrar del lado del servidor)
            if (descuentoAplicado > subtotal) descuentoAplicado = subtotal;

            const baseGravable = Math.max(0, subtotal - descuentoAplicado);
            const impuesto = baseGravable * TASA_IVA;
            const total = baseGravable + impuesto;

            document.getElementById('lblSubtotal').innerText = subtotal.toFixed(2);
            document.getElementById('lblDescuentoAplicado').innerText = descuentoAplicado.toFixed(2);
            document.getElementById('lblBaseGravable').innerText = baseGravable.toFixed(2);
            document.getElementById('lblImpuesto').innerText = impuesto.toFixed(2);
            document.getElementById('lblTotal').innerText = total.toFixed(2);

            document.getElementById('DescuentoReal').value = descuentoAplicado;

            const contenedor = document.getElementById('itemsOcultos');
            contenedor.innerHTML = '';
            carrito.forEach((item, i) => {
                contenedor.innerHTML += `<input type="hidden" name="Items[${i}].IdProducto" value="${item.idProducto}" />
                    <input type="hidden" name="Items[${i}].Cantidad" value="${item.cantidad}" />`;
            });
        }

        function quitar(i) { carrito.splice(i, 1); render(); }

        document.getElementById('formVenta').addEventListener('submit', (e) => {
            if (carrito.length === 0) {
                e.preventDefault();
                alert('Agregue al menos un producto antes de guardar.');
            }
        });

        render(); // pinta la tabla vacia y los totales en 0 al cargar
    </script>
}