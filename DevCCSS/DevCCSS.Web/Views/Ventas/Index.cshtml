@model List<DevCCSS.Web.Contracts.VentaDto>
@{
    ViewData["Title"] = "Ventas";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-receipt"></i> Ventas y Facturación</h2>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Nueva venta</a>
</div>

<!-- Buscador dinamico -->
<div class="row g-2 mb-3">
    <div class="col-md-8">
        <input type="text" id="buscador" class="form-control"
               placeholder="Buscar por número de factura, cliente o empleado..." />
    </div>
    <div class="col-md-4">
        <select id="filtroMetodo" class="form-select" data-campo="metodo">
            <option value="">Todos los métodos de pago</option>
            @foreach (var metodo in Model.Select(v => v.MetodoPago).Distinct().OrderBy(x => x))
            {
                <option value="@metodo">@metodo</option>
            }
        </select>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr><th>Factura</th><th>Fecha</th><th>Cliente</th><th>Total</th><th>Método</th><th class="text-end">Acciones</th></tr>
        </thead>
        <tbody>
            @foreach (var v in Model)
            {
                <tr class="fila-venta"
                    data-buscar="@($"{v.IdFactura} {v.ClienteNombreCompleto} {v.ClienteIdentificacion} {v.EmpleadoNombreCompleto}".ToLower())"
                    data-metodo="@v.MetodoPago">
                    <td>#@v.IdFactura</td>
                    <td>@v.FechaFactura.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@(v.ClienteNombreCompleto ?? "Cliente ocasional")</td>
                    <td>₡@v.Total.ToString("N2")</td>
                    <td>@v.MetodoPago</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@v.IdFactura"><i class="bi bi-eye"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div id="sinResultados" class="text-center text-muted py-4" style="display:none;">
    No se encontraron ventas con esa búsqueda.
</div>

<nav>
    <ul class="pagination justify-content-center" id="paginacion"></ul>
</nav>

@section Scripts {
    <script>
        initTablaFiltro({
            filas: '.fila-venta',
            buscador: '#buscador',
            filtros: ['#filtroMetodo'],
            contenedorPaginacion: '#paginacion',
            sinResultados: '#sinResultados'
        });
    </script>
}
