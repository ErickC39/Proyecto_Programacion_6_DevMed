@model List<DevCCSS.Web.Contracts.EmpleadoDto>
@{
    ViewData["Title"] = "Empleados";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-person-badge"></i> Empleados</h2>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Nuevo</a>
</div>

<!-- Buscador dinamico -->
<div class="row g-2 mb-3">
    <div class="col-md-8">
        <input type="text" id="buscador" class="form-control"
               placeholder="Buscar por nombre, apellidos o identificación..." />
    </div>
    <div class="col-md-4">
        <select id="filtroCargo" class="form-select" data-campo="cargo">
            <option value="">Todos los cargos</option>
            @foreach (var cargo in Model.Where(x => !string.IsNullOrEmpty(x.Cargo))
                                         .Select(x => x.Cargo).Distinct().OrderBy(x => x))
            {
                <option value="@cargo">@cargo</option>
            }
        </select>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Identificación</th>
                <th>Nombre</th>
                <th>Apellidos</th>
                <th>Cargo</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var x in Model)
            {
                <tr class="fila-empleado"
                    data-buscar="@($"{x.Nombre} {x.Apellidos} {x.Identificacion}".ToLower())"
                    data-cargo="@x.Cargo">
                    <td>@x.Identificacion</td>
                    <td>@x.Nombre</td>
                    <td>@x.Apellidos</td>
                    <td>@(x.Cargo ?? "-")</td>
                    <td>
                        @if (x.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </td>
                    <td class="text-end">
                        <div class="btn-group" role="group">
                            <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@x.IdEmpleado" title="Ver detalle"><i class="bi bi-eye"></i></a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@x.IdEmpleado" title="Editar"><i class="bi bi-pencil"></i></a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@x.IdEmpleado" title="Eliminar"><i class="bi bi-trash"></i></a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div id="sinResultados" class="text-center text-muted py-4" style="display:none;">
    No se encontraron empleados con esa búsqueda.
</div>

<nav>
    <ul class="pagination justify-content-center" id="paginacion"></ul>
</nav>

@section Scripts {
    <script>
        initTablaFiltro({
            filas: '.fila-empleado',
            buscador: '#buscador',
            filtros: ['#filtroCargo'],
            contenedorPaginacion: '#paginacion',
            sinResultados: '#sinResultados'
        });
    </script>
}
