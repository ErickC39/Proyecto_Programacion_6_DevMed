@model DevCCSS.Web.Contracts.EmpleadoDto
@{
    ViewData["Title"] = "Editar registro";
}
<h2 class="mb-3"><i class="bi bi-person-badge"></i> Editar</h2>
<div class="card shadow-sm"><div class="card-body">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger small mb-3"></div>
        <partial name="_Form" model="Model" />
        <div class="mt-4">
            <button class="btn btn-primary" type="submit"><i class="bi bi-save"></i> Guardar</button>
            <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div></div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>initSelectBuscable('#IdPacienteVinculado', '#filtroPacienteVinculado');</script>
}
