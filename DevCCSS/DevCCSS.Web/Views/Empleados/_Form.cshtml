@model DevCCSS.Web.Contracts.EmpleadoDto

<div class="row g-3">
    <input type="hidden" asp-for="IdEmpleado" />
    <input type="hidden" asp-for="Activo" />
    @if (Model.IdEmpleado > 0)
    {
        <div class="col-md-6">
            <label class="form-label">Identificación</label>
            <input asp-for="Identificacion" class="form-control" />
            <span asp-validation-for="Identificacion" class="text-danger small"></span>
        </div>
    }
    else
    {
        <div class="col-md-6">
            <label class="form-label">Identificación</label>
            <input class="form-control" value="Se asignará automáticamente (EMP-###)" disabled />
        </div>
    }
    <div class="col-md-6">
        <label class="form-label">Nombre</label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label class="form-label">Apellidos</label>
        <input asp-for="Apellidos" class="form-control" />
        <span asp-validation-for="Apellidos" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label class="form-label">Especialidad</label>
        <input asp-for="Especialidad" class="form-control" />
        <span asp-validation-for="Especialidad" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label class="form-label">Salario por hora</label>
        <input asp-for="SalarioPorHora" type="number" step="0.01" class="form-control" />
        <span asp-validation-for="SalarioPorHora" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label class="form-label">Usuario del sistema</label>
        <select asp-for="IdUsuario" class="form-select">
            <option value="">-- Seleccione --</option>
            @foreach (var u in (List<DevCCSS.Web.Contracts.UsuarioDto>)ViewBag.Usuarios)
            {
                <option value="@u.IdUsuario">@u.Username</option>
            }
        </select>
    </div>

    <div class="col-md-6">
        <label class="form-label">Vincular como paciente (acceso de emergencia)</label>
        <input type="text" id="filtroPacienteVinculado" class="form-control form-control-sm mb-1" placeholder="Buscar paciente..." />
        <select asp-for="IdPacienteVinculado" class="form-select">
            <option value="">-- Sin vincular --</option>
            @foreach (var p in (List<DevCCSS.Web.Contracts.PacienteDto>)ViewBag.Pacientes)
            {
                <option value="@p.IdPaciente">@p.Nombre @p.Apellidos (@p.Identificacion)</option>
            }
        </select>
        <small class="text-muted">
            Si se vincula, este empleado podrá solicitar una "cita de emergencia" desde su ficha,
            sin turno previo, reagendando automáticamente las citas del médico que choquen.
        </small>
    </div>
</div>
