@model DevCCSS.Web.Contracts.EmpleadoDto
@{
    ViewData["Title"] = "Detalle";
}
<h2 class="mb-3"><i class="bi bi-person-badge"></i> Detalle</h2>
<div class="card shadow-sm"><div class="card-body">
    <dl class="row mb-0">
            <dt class="col-sm-4">Identificación</dt><dd class="col-sm-8">@Model.Identificacion</dd>
            <dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">@Model.Nombre</dd>
            <dt class="col-sm-4">Apellidos</dt><dd class="col-sm-8">@Model.Apellidos</dd>
            <dt class="col-sm-4">Especialidad</dt><dd class="col-sm-8">@Model.Especialidad</dd>
            <dt class="col-sm-4">Salario por hora</dt><dd class="col-sm-8">@Model.SalarioPorHora</dd>
            <dt class="col-sm-4">Usuario asignado</dt><dd class="col-sm-8">@Model.UsuarioAsignado</dd>
            <dt class="col-sm-4">Paciente vinculado</dt><dd class="col-sm-8">@(Model.NombrePacienteVinculado ?? "Ninguno")</dd>
            <dt class="col-sm-4">Estado</dt>
            <dd class="col-sm-8">
                @if (Model.Activo)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactivo</span>
                }
            </dd>
    </dl>
</div></div>
<div class="mt-3">
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.IdEmpleado">Editar</a>
    @if (Model.IdPacienteVinculado.HasValue)
    {
        <a class="btn btn-danger" asp-controller="Citas" asp-action="AgendarEmergencia" asp-route-idEmpleado="@Model.IdEmpleado">
            <i class="bi bi-exclamation-octagon"></i> Agendar cita de emergencia
        </a>
    }
    <form asp-action="CambiarEstado" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.IdEmpleado" />
        <input type="hidden" name="activo" value="@(!Model.Activo)" />
        @if (Model.Activo)
        {
            <button type="submit" class="btn btn-outline-danger" onclick="return confirm('¿Desactivar a este empleado?');">
                <i class="bi bi-person-dash"></i> Desactivar
            </button>
        }
        else
        {
            <button type="submit" class="btn btn-outline-success" onclick="return confirm('¿Activar a este empleado?');">
                <i class="bi bi-person-check"></i> Activar
            </button>
        }
    </form>
    <a class="btn btn-secondary" asp-action="Index">Volver</a>
</div>
